# R session artifacts
.Rhistory
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
.Renviron

# Quarto build internals (not needed in git)
/.quarto/
_freeze/
_quarto_internal_*.scss

# Quarto intermediate render artifacts for SOURCE .qmd files.
# The published copies live in docs/ (whitelisted below); these are
# regenerated on every render and only create diff churn.
**/*_cache/
content/**/*_files/
/_site/
*.webloc

# Ignore rendered files everywhere EXCEPT inside docs/
# (docs/ is what GitHub Pages serves)
**/*.html
**/*.docx
**/*.pptx
**/*.pdf
**/*.quarto_ipynb
*_cache/
*.utf8.md
*.knit.md

# ── Whitelist docs/ so GitHub Pages works ──
!/docs/
!/docs/**

# ── Keep source HTML includes (not build output) ──
!/css/*.html

# macOS / Positron noise
.DS_Store
**/.DS_Store
.positai

# Quiz answers — never upload
/quizzes/
# ...including the RENDERED quizzes. These carry the answer key and were
# being served from the public Pages site and indexed in docs/search.json.
# Quizzes are given on paper (see syllabus), so they are never published.
# This must sit AFTER the !/docs/** whitelist above to take effect.
/docs/quizzes/

# Reference-only sibling course, not part of this site's build
/web_ecostats_website_2026/
# Excel lock/temp files
~$*

/.luarc.json
